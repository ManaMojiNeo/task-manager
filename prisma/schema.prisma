generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamRole {
  owner
  team_lead
  member
}

enum InvitationStatus {
  pending
  accepted
  declined
  expired
}

enum TaskStatus {
  todo
  in_progress
  in_review
  done
  archived
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum NotificationType {
  task_assigned
  task_updated
  comment_added
  mentioned
  invitation_received
  due_date_reminder
}

model User {
  id           String   @id @default(uuid()) @map("user_id")
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  avatarUrl    String?  @map("avatar_url") @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedTeams        Team[]             @relation("TeamOwner")
  teamMemberships   TeamMember[]
  sentInvitations   Invitation[]       @relation("InvitationSender")
  createdProjects   Project[]          @relation("ProjectCreator")
  createdTasks      Task[]             @relation("TaskCreator")
  assignments       TaskAssignment[]   @relation("Assignee")
  assignedBy        TaskAssignment[]   @relation("Assigner")
  comments          Comment[]
  uploadedFiles     Attachment[]
  notifications     Notification[]

  @@map("users")
}

model Team {
  id          String   @id @default(uuid()) @map("team_id")
  name        String   @db.VarChar(150)
  description String?
  ownerId     String   @map("owner_id")
  owner       User     @relation("TeamOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members     TeamMember[]
  invitations Invitation[]
  projects    Project[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  role     TeamRole @default(member)
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Invitation {
  id        String           @id @default(uuid()) @map("invitation_id")
  teamId    String           @map("team_id")
  email     String           @db.VarChar(255)
  invitedBy String           @map("invited_by")
  role      TeamRole         @default(member)
  status    InvitationStatus @default(pending)
  token     String           @unique @db.VarChar(255)
  expiresAt DateTime         @map("expires_at")
  createdAt DateTime         @default(now()) @map("created_at")

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter User @relation("InvitationSender", fields: [invitedBy], references: [id])

  @@index([teamId])
  @@index([email])
  @@map("invitations")
}

model Project {
  id          String   @id @default(uuid()) @map("project_id")
  teamId      String   @map("team_id")
  name        String   @db.VarChar(150)
  description String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  team    Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator User   @relation("ProjectCreator", fields: [createdBy], references: [id])
  tasks   Task[]

  @@index([teamId])
  @@map("projects")
}

model Task {
  id          String       @id @default(uuid()) @map("task_id")
  projectId   String       @map("project_id")
  title       String       @db.VarChar(200)
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?    @map("due_date") @db.Date
  createdBy   String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator       User             @relation("TaskCreator", fields: [createdBy], references: [id])
  assignments   TaskAssignment[]
  comments      Comment[]
  attachments   Attachment[]
  notifications Notification[]

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model TaskAssignment {
  taskId     String   @map("task_id")
  userId     String   @map("user_id")
  assignedBy String   @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee User @relation("Assignee", fields: [userId], references: [id], onDelete: Cascade)
  assigner User @relation("Assigner", fields: [assignedBy], references: [id])

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignments")
}

model Comment {
  id        String   @id @default(uuid()) @map("comment_id")
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])
  attachments Attachment[]

  @@index([taskId])
  @@map("comments")
}

model Attachment {
  id             String   @id @default(uuid()) @map("attachment_id")
  taskId         String?  @map("task_id")
  commentId      String?  @map("comment_id")
  fileName       String   @map("file_name") @db.VarChar(255)
  fileUrl        String   @map("file_url") @db.VarChar(500)
  fileSizeBytes  BigInt?  @map("file_size_bytes")
  mimeType       String?  @map("mime_type") @db.VarChar(100)
  uploadedBy     String   @map("uploaded_by")
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@index([taskId])
  @@index([commentId])
  @@map("attachments")
}

model Notification {
  id            String           @id @default(uuid()) @map("notification_id")
  userId        String           @map("user_id")
  type          NotificationType
  content       String           @db.VarChar(500)
  isRead        Boolean          @default(false) @map("is_read")
  relatedTaskId String?          @map("related_task_id")
  createdAt     DateTime         @default(now()) @map("created_at")

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedTask Task? @relation(fields: [relatedTaskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}
